<?xml version="1.0" encoding="utf-8"?>
<!-- Everything off the phone is HTTPS. The one exception is loopback: the Rust core serves the audio
     and music-video bytes to ExoPlayer and the webview from 127.0.0.1 (audioproxy.rs,
     videoproxy.rs), and that has to be plain http. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
